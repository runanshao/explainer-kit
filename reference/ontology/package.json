    "render:en": "remotion render src/index.ts OntologyEN out/ontology-en.mp4"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.529",
    "katex": "^0.18.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "^4.0.529"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
